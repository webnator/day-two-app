# Copia a .env y ajusta. Nunca subas .env al repositorio.
PORT=8787
HOST=0.0.0.0
# true solo detrás de un proxy inverso de confianza (para que el límite por IP use X-Forwarded-For)
TRUST_PROXY=false
PUBLIC_BASE_URL=http://localhost:8787
DATA_DIR=./data
# Secreto largo y aleatorio: `openssl rand -hex 32`. Obligatorio fuera de desarrollo.
OTP_PEPPER=""

# SMTP. En desarrollo, Mailpit (docker compose up -d).
# MAIL_FROM tiene prioridad sobre SMTP_FROM cuando se define.
# Producción: Amazon SES (email-smtp.eu-west-1.amazonaws.com, 587, SMTP_SECURE=false: STARTTLS obligatorio).
# MAIL_FROM="Day Two <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Day Two <no-reply@daytwo.local>"
# Solo para npm run smoke / pruebas de integración
MAILPIT_URL=http://localhost:8025

# ---------- Proveedores elegidos (configure your own Google project) ----------
# Transcripción: chirp3 (Google, por defecto) | groq | whisper (local) | deepgram (esqueleto)
TRANSCRIBER=chirp3
# Clasificación: gemini (por defecto) | ollama (local) | anthropic
CLASSIFIER=gemini

# Google Cloud. Autenticación por ADC (gcloud auth application-default login / cuenta de servicio). Sin ficheros de clave en el repo.
GOOGLE_CLOUD_PROJECT=""
SPEECH_LOCATION=eu
# Bucket privado en la UE para audio > 55 s (objetos borrados al terminar; regla de ciclo de vida de 1 día)
GCS_TRANSCRIBE_BUCKET=""
# Códigos de idioma de Chirp 3 cuando el cliente envía languageHint=auto. es-ES,en-US evaluado mejor que
# auto (auto llegó a detectar guaraní en una frase con nombres vascos). Usa auto para otros idiomas.
CHIRP_LANGUAGE_CODES=es-ES,en-US
# Divide en pausas y envía cada tramo en línea: no omite frases en otro idioma y no usa el bucket
# salvo tramos > 55 s sin pausas. See provider adapter source
CHIRP_SEGMENTED=true
# Chirp usa además su denoiser para reducir artefactos durante ruido/silencio.
# No evita todos los errores: la cola rechaza texto vacío y bucles extensos de repetición.

# Gemini API (solo en el servidor; nunca en mobile/ ni en EXPO_PUBLIC_*)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# ---------- Adaptadores alternativos ----------
# Groq: Whisper completo para priorizar precisión. Solo en el backend.
GROQ_API_KEY=""
GROQ_MODEL=whisper-large-v3
# Se envía la grabación completa en FLAC mono 16 kHz, máximo 25 MB tras conversión.
# La copia temporal se borra también al fallar. Nunca se modifica el original.
WHISPER_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=""
WHISPER_THREADS=8
# Divide en pausas y detecta idioma por tramo (evita omitir frases en otro idioma). See provider adapter source
WHISPER_CODE_SWITCHING=true
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
FFPROBE_BIN=/opt/homebrew/bin/ffprobe
TRANSCRIBE_CONCURRENCY=1
DEEPGRAM_API_KEY=""

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Contexto (Open-Meteo + Nominatim, sin clave)
NOMINATIM_USER_AGENT="DayTwo/0.1 (personal journaling app; contact via repo owner)"
LOG_LEVEL=info

# Only for local E2E runs (default 20 per IP and hour).
OTP_PER_IP_PER_HOUR=""
