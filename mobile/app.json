{
  "expo": {
    "name": "Day Two",
    "slug": "day-two",
    "scheme": "daytwo",
    "version": "0.1.3",
    "extra": {
      "apiUrl": "http://localhost:8787"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "app.daytwo.journal",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Day Two usa el micrófono para grabar tus notas de voz.",
        "NSLocationWhenInUseUsageDescription": "Day Two guarda la ciudad y el tiempo del momento en que grabas, si lo permites.",
        "NSCameraUsageDescription": "Day Two usa la cámara para la foto de tu día.",
        "NSPhotoLibraryUsageDescription": "Day Two te deja elegir la foto de tu día y recursos de tu fototeca.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.daytwo.journal",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Tinos-Regular.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Day Two usa el micrófono para grabar tus notas de voz.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Day Two guarda la ciudad y el tiempo del momento en que grabas, si lo permites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Day Two te deja elegir la foto de tu día y recursos de tu fototeca.",
          "cameraPermission": "Day Two usa la cámara para la foto de tu día.",
          "microphonePermission": "Day Two usa el micrófono para grabar tus notas de voz."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111210"
        }
      ],
      "expo-document-picker",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
